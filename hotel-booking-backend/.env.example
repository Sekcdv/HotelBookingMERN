# ============================================================
# Hotel Booking Backend — Environment Variables
# REQ-0028 · PLANTILLA: nunca poner valores reales aquí.
# Copia este archivo a .env (gitignored) y rellena tus valores.
# En Coolify cargar los mismos nombres en el dashboard.
# ============================================================

# ---------- SERVER ----------
# Puerto canónico del repo. En Coolify: PORT=5001
PORT=5001
# Local = development
NODE_ENV=development

# ---------- DATABASE ----------
# ⚠️ REEMPLAZAR por tu URI real SOLO en .env (URL-encoded si tiene caracteres especiales).
# ⚠️ Sin nombre de BD en la URI Mongoose usa "test"; añade /hotel-booking si quieres otro nombre.
MONGODB_CONNECTION_STRING=your_mongodb_connection_string_here

# ---------- AUTH ----------
# Generado con crypto.randomBytes(48). En producción usa otro valor distinto a este.
JWT_SECRET_KEY=your_jwt_secret_here

# ---------- URLS ----------
FRONTEND_URL=https://your-frontend.example.com
BACKEND_URL=https://your-backend.example.com

# ---------- GOOGLE OAUTH (opcional) ----------
# Registrar: https://hotel-booking-backend.arnobmahmud.com/api/auth/callback/google
GOOGLE_ID=your_google_client_id
GOOGLE_SECRET=your_google_client_secret

# ---------- CLOUDINARY ----------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
# ⚠️ RELLENAR MANUALMENTE antes de desplegar
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ---------- STRIPE ----------
# ⚠️ RELLENAR MANUALMENTE antes de desplegar (sk_test_... o sk_live_...)
STRIPE_API_KEY=your_stripe_secret_key_here
VITE_STRIPE_PUB_KEY=your_stripe_publishable_key_here

# ---------- AI ASSIST (opcional) ----------
AI_ASSIST_ENABLED=false
# GROQ_API_KEY=your_groq_api_key
# OPENAI_API_KEY=your_openai_api_key
# OPENROUTER_API_KEY=your_openrouter_api_key
