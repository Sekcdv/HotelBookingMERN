# ================================================
# Hotel Booking Backend — Environment Variables
# REQ-0028 · gitignored — NUNCA commitear este archivo
# En Coolify cargar los mismos nombres en el dashboard (ver respuesta final)
# ================================================

# ---------- SERVER ----------
# Puerto canónico del repo. En Coolify: PORT=3000 + mapeo 5001:3000 (o 5001:5001).
PORT=5001
# Local = development. En producción (Coolify) cambiar a production.
NODE_ENV=development

# ---------- DATABASE ----------
# ⚠️ REEMPLAZAR <db_password> por la contraseña real (URL-encoded si tiene caracteres especiales).
# ⚠️ Sin nombre de BD en la URI Mongoose usa "test"; añade /hotel-booking si quieres otro nombre.
MONGODB_CONNECTION_STRING=your_mongodb_connection_string_here

# ---------- AUTH ----------
# Generado con crypto.randomBytes(48). En producción usa otro valor distinto a este.
JWT_SECRET_KEY=your_jwt_secret_here

# ---------- URLS (valores actuales del repo) ----------
FRONTEND_URL=https://hotel-mern-booking.vercel.app
BACKEND_URL=https://hotel-booking-backend.arnobmahmud.com

# ---------- GOOGLE OAUTH (opcional) ----------
# Registrar: https://hotel-booking-backend.arnobmahmud.com/api/auth/callback/google
GOOGLE_ID=
GOOGLE_SECRET=

# ---------- CLOUDINARY ----------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
# ⚠️ RELLENAR MANUALMENTE antes de desplegar
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ---------- STRIPE ----------
# ⚠️ RELLENAR MANUALMENTE antes de desplegar (sk_test_... o sk_live_...)
STRIPE_API_KEY=your_stripe_secret_key_here
VITE_STRIPE_PUB_KEY=your_stripe_publishable_key_here

# ---------- AI ASSIST (opcional) ----------
AI_ASSIST_ENABLED=false
# GROQ_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
